# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
# Keep the Dockerfile + app/templates/static + requirements.txt; drop the rest.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
*.egg-info
agentic_search.egg-info
.env
.env.*
!.env.example
data/
tests/
docs/
scripts/
BUILD_JOURNAL.md
.claude
